# RecruitFlow — EditorConfig
# https://editorconfig.org
# Garantiza consistencia de formato en todos los editores (VS Code, IntelliJ, vim...)

root = true

# ── Todos los archivos ────────────────────────────────────
[*]
charset              = utf-8
end_of_line          = lf
indent_style         = space
indent_size          = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length      = 100

# ── Java (Google Style) ───────────────────────────────────
[*.java]
indent_size          = 2
max_line_length      = 100

# ── TypeScript / TSX ─────────────────────────────────────
[*.{ts,tsx}]
indent_size          = 2

# ── JSON ─────────────────────────────────────────────────
[*.json]
indent_size          = 2

# ── YAML / properties ────────────────────────────────────
[*.{yml,yaml,properties}]
indent_size          = 2

# ── SQL Migrations ───────────────────────────────────────
[*.sql]
indent_size          = 4
max_line_length      = off

# ── Markdown ─────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
max_line_length          = 80

# ── Makefiles — requieren tabulaciones ───────────────────
[Makefile]
indent_style = tab
