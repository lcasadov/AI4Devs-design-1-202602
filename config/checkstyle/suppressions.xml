<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  RecruitFlow — Checkstyle Suppressions
  Las supresiones deben ser la excepción, no la regla.
  Cada entrada debe justificarse con un comentario.
-->
<suppressions>

  <!-- Código generado automáticamente por OpenAPI Generator o MapStruct -->
  <suppress files="[/\\]generated[/\\]" checks=".*"/>

  <!-- Migraciones Flyway — SQL puede tener líneas largas en DDL -->
  <suppress files="[/\\]migration[/\\]" checks="LineLength"/>

  <!-- Tests — relajar restricciones para mejorar legibilidad de los tests -->
  <suppress files="Test\.java$"  checks="MethodLength"/>
  <suppress files="Test\.java$"  checks="MagicNumber"/>
  <suppress files="Test\.java$"  checks="JavadocMethod"/>
  <suppress files="Test\.java$"  checks="MissingJavadocMethod"/>
  <suppress files="IT\.java$"    checks="MethodLength"/>
  <suppress files="IT\.java$"    checks="MagicNumber"/>
  <suppress files="IT\.java$"    checks="JavadocMethod"/>

  <!-- Object Mothers y Factories de test — sin Javadoc obligatorio -->
  <suppress files="Mother\.java$"  checks="MissingJavadocMethod"/>
  <suppress files="Factory\.java$" checks="MissingJavadocMethod"/>

  <!-- Configuración Spring — los @Bean pueden tener nombres especiales -->
  <suppress files="Config\.java$"  checks="MethodName"/>

  <!-- Aspectos AOP — los pointcuts usan sintaxis especial -->
  <suppress files="Aspect\.java$"  checks="MethodName"/>

</suppressions>
