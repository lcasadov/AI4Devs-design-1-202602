<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  RecruitFlow — Checkstyle Configuration
  Basado en Google Java Style Guide + reglas OWASP de seguridad
  Versión: 1.0 | Fecha: 2026-04-04
-->
<module name="Checker">
  <property name="severity"        value="error"/>
  <property name="fileExtensions"  value="java"/>

  <module name="SuppressWarningsFilter"/>
  <module name="SuppressionFilter">
    <property name="file"     value="${config_loc}/suppressions.xml"/>
    <property name="optional" value="false"/>
  </module>

  <!-- ═══════════════════════════════════════════════════════════
       ARCHIVOS
       ═══════════════════════════════════════════════════════════ -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
    <message key="containsTab" value="El archivo contiene tabulaciones. Usar 2 espacios (Google Style)."/>
  </module>

  <module name="NewlineAtEndOfFile">
    <property name="lineSeparator" value="lf"/>
  </module>

  <module name="FileLength">
    <property name="max" value="500"/>
    <message key="maxLen.file" value="El archivo supera las 500 líneas. Considerar dividirlo."/>
  </module>

  <!-- ═══════════════════════════════════════════════════════════
       TREE WALKER — reglas a nivel de token
       ═══════════════════════════════════════════════════════════ -->
  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>

    <!-- ─── IMPORTS ─────────────────────────────────────────── -->
    <module name="AvoidStarImport">
      <message key="import.avoidStar" value="No usar wildcard imports (.*). Importar explícitamente cada clase."/>
    </module>
    <module name="UnusedImports">
      <property name="processJavadoc" value="true"/>
    </module>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, com.sun"/>
      <message key="import.illegal" value="OWASP: No usar clases internas de la JVM (sun.*, com.sun.*)."/>
    </module>
    <module name="RedundantImport"/>
    <module name="ImportOrder">
      <property name="groups"     value="/^java\./,/^javax\./,/^jakarta\./,/^org\./,/^com\.(?!recruitflow)/,com.recruitflow"/>
      <property name="separated"  value="true"/>
      <property name="option"     value="top"/>
      <property name="sortStaticImportsAlphabetically" value="true"/>
    </module>

    <!-- ─── NOMENCLATURA ────────────────────────────────────── -->
    <module name="TypeName">
      <property name="format"  value="^[A-Z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="Los tipos deben usar PascalCase: ''{0}'' no es válido."/>
    </module>
    <module name="MethodName">
      <property name="format"  value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="Los métodos deben usar camelCase: ''{0}'' no es válido."/>
    </module>
    <module name="ParameterName">
      <property name="format"  value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="LocalVariableName">
      <property name="format"  value="^[a-z][a-zA-Z0-9]*$"/>
      <property name="allowOneCharVarInForLoop" value="true"/>
    </module>
    <module name="MemberName">
      <property name="format"  value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="ConstantName">
      <property name="format"  value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
      <message key="name.invalidPattern" value="Las constantes deben usar UPPER_SNAKE_CASE: ''{0}'' no es válido."/>
    </module>
    <module name="PackageName">
      <property name="format"  value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
      <message key="name.invalidPattern" value="Los paquetes deben estar en minúsculas: ''{0}'' no es válido."/>
    </module>
    <module name="ClassTypeParameterName">
      <property name="format"  value="^[A-Z][0-9]?$"/>
    </module>
    <module name="MethodTypeParameterName">
      <property name="format"  value="^[A-Z][0-9]?$"/>
    </module>
    <module name="InterfaceTypeParameterName">
      <property name="format"  value="^[A-Z][0-9]?$"/>
    </module>

    <!-- ─── LONGITUD Y TAMAÑO ─────────────────────────────── -->
    <module name="LineLength">
      <property name="max"           value="100"/>
      <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
      <message key="maxLineLength"   value="La línea supera los 100 caracteres (Google Style). Valor actual: {0,number,integer}."/>
    </module>
    <module name="MethodLength">
      <property name="max"    value="40"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
      <message key="maxLen.method" value="El método supera las 40 líneas. Extraer responsabilidades a métodos privados."/>
    </module>
    <module name="ParameterNumber">
      <property name="max"    value="5"/>
      <message key="maxParam" value="Demasiados parámetros ({0,number,integer}). Máximo 5. Usar un objeto Command/Request."/>
    </module>
    <module name="AnonInnerLength">
      <property name="max" value="20"/>
    </module>

    <!-- ─── COMPLEJIDAD ──────────────────────────────────── -->
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
      <message key="cyclomaticComplexity" value="Complejidad ciclomática {0,number,integer} supera el máximo de 10. Extraer lógica."/>
    </module>
    <module name="NPathComplexity">
      <property name="max" value="200"/>
    </module>
    <module name="BooleanExpressionComplexity">
      <property name="max" value="4"/>
    </module>
    <module name="ClassFanOutComplexity">
      <property name="max" value="20"/>
    </module>

    <!-- ─── LLAVES Y FORMATO ──────────────────────────────── -->
    <module name="NeedBraces">
      <message key="needBraces" value="Se requieren llaves para ''{0}''. No omitir llaves en bloques de una línea."/>
    </module>
    <module name="LeftCurly">
      <property name="option" value="eol"/>
    </module>
    <module name="RightCurly">
      <property name="option"  value="same"/>
      <property name="tokens"  value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, CLASS_DEF, METHOD_DEF, CTOR_DEF, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT"/>
    </module>
    <module name="EmptyBlock">
      <property name="option"  value="TEXT"/>
      <property name="tokens"  value="LITERAL_WHILE, LITERAL_TRY, LITERAL_FINALLY, LITERAL_DO, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, INSTANCE_INIT, STATIC_INIT, LITERAL_SWITCH, LITERAL_SYNCHRONIZED"/>
      <message key="block.empty" value="OWASP: No dejar bloques catch vacíos. Los errores silenciados ocultan problemas de seguridad."/>
    </module>

    <!-- ─── ESPACIADO ────────────────────────────────────── -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors"  value="true"/>
      <property name="allowEmptyMethods"       value="true"/>
      <property name="allowEmptyTypes"         value="true"/>
      <property name="allowEmptyLambdas"       value="true"/>
    </module>
    <module name="WhitespaceAfter">
      <property name="tokens" value="COMMA, SEMI, TYPECAST, LITERAL_IF, LITERAL_WHILE, LITERAL_DO, LITERAL_FOR, DO_WHILE"/>
    </module>
    <module name="NoWhitespaceBefore">
      <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC, GENERIC_END"/>
    </module>
    <module name="GenericWhitespace"/>
    <module name="Indentation">
      <property name="basicOffset"             value="2"/>
      <property name="braceAdjustment"         value="0"/>
      <property name="caseIndent"              value="2"/>
      <property name="throwsIndent"            value="4"/>
      <property name="lineWrappingIndentation" value="4"/>
      <property name="arrayInitIndent"         value="2"/>
    </module>
    <module name="EmptyLineSeparator">
      <property name="tokens"                        value="IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF, STATIC_INIT, INSTANCE_INIT, METHOD_DEF, CTOR_DEF, VARIABLE_DEF, RECORD_DEF, COMPACT_CTOR_DEF"/>
      <property name="allowMultipleEmptyLines"       value="false"/>
      <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
    </module>

    <!-- ─── JAVADOC ──────────────────────────────────────── -->
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public"/>
      <property name="allowUndeclaredRTE" value="true"/>
      <property name="validateThrows"   value="true"/>
      <property name="tokens"           value="METHOD_DEF, ANNOTATION_FIELD_DEF"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope"         value="public"/>
      <property name="minLineCount"  value="3"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
    </module>
    <module name="JavadocType">
      <property name="scope"         value="public"/>
      <property name="allowMissingParamTags" value="false"/>
    </module>
    <module name="JavadocVariable">
      <property name="scope"         value="public"/>
    </module>
    <module name="NonEmptyAtclauseDescription"/>
    <module name="AtclauseOrder">
      <property name="tagOrder" value="@param, @return, @throws, @deprecated"/>
    </module>

    <!-- ─── BUENAS PRÁCTICAS ─────────────────────────────── -->
    <module name="EqualsHashCode">
      <message key="equals.noHashCode" value="Si sobreescribes equals(), debes sobreescribir hashCode() también."/>
    </module>
    <module name="HiddenField">
      <property name="ignoreSetter"                value="true"/>
      <property name="ignoreConstructorParameter"  value="true"/>
      <property name="ignoreAbstractMethods"       value="true"/>
    </module>
    <module name="IllegalInstantiation">
      <property name="classes" value="java.lang.Boolean, java.lang.Integer, java.lang.Long"/>
    </module>
    <module name="MagicNumber">
      <property name="ignoreNumbers"         value="-1, 0, 1, 2, 100"/>
      <property name="ignoreAnnotation"      value="true"/>
      <property name="ignoreHashCodeMethod"  value="true"/>
      <property name="ignoreFieldDeclaration" value="true"/>
      <message key="magic.number" value="Número mágico ''{0}''. Extraer a una constante con nombre descriptivo."/>
    </module>
    <module name="MultipleVariableDeclarations">
      <message key="multiple.variable.declarations" value="Declarar una variable por línea (Google Style)."/>
    </module>
    <module name="OneStatementPerLine"/>
    <module name="StringLiteralEquality">
      <message key="string.literal.equality" value="Usar String.equals() en lugar de == para comparar strings."/>
    </module>
    <module name="SuperClone"/>
    <module name="SuperFinalize"/>
    <module name="FinalLocalVariable">
      <property name="tokens" value="VARIABLE_DEF, PARAMETER_DEF"/>
    </module>
    <module name="UnnecessaryParentheses"/>
    <module name="UnnecessarySemicolon"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="CovariantEquals"/>
    <module name="DefaultComesLast"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <module name="NoFinalizer">
      <message key="avoid.finalizer.method" value="No usar finalize(). Implementar Closeable/AutoCloseable si se necesita limpieza."/>
    </module>

    <!-- ─── MODIFICADORES ───────────────────────────────── -->
    <module name="ModifierOrder">
      <property name="tokens" value="VARIABLE_DEF, METHOD_DEF, INTERFACE_DEF, CLASS_DEF, ANNOTATION_FIELD_DEF"/>
    </module>
    <module name="RedundantModifier"/>

    <!-- ═══════════════════════════════════════════════════
         REGLAS DE SEGURIDAD OWASP
         ═══════════════════════════════════════════════════ -->

    <!-- OWASP: No usar printStackTrace() — loggear con SLF4J -->
    <module name="Regexp">
      <property name="id"             value="owasp-no-print-stack-trace"/>
      <property name="format"         value="\.printStackTrace\(\)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message"        value="OWASP A09: No usar printStackTrace(). Usar logger.error(&quot;msg&quot;, exception)."/>
    </module>

    <!-- OWASP: No usar System.out -->
    <module name="Regexp">
      <property name="id"             value="owasp-no-system-out"/>
      <property name="format"         value="System\.(out|err)\.print"/>
      <property name="illegalPattern" value="true"/>
      <property name="message"        value="No usar System.out/err. Usar SLF4J logger con el nivel apropiado."/>
    </module>

    <!-- OWASP: No capturar Exception genérica -->
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="java.lang.Exception, java.lang.RuntimeException, java.lang.Throwable"/>
      <message key="illegal.catch" value="OWASP A05: No capturar ''{0}'' genérico. Capturar excepciones específicas."/>
    </module>

    <!-- OWASP: No lanzar Exception genérica -->
    <module name="IllegalThrows">
      <property name="illegalClassNames" value="java.lang.Exception, java.lang.RuntimeException, java.lang.Throwable"/>
      <message key="illegal.throw" value="No lanzar ''{0}'' genérico. Usar excepciones de dominio específicas."/>
    </module>

    <!-- OWASP: TODOs deben referenciar un issue -->
    <module name="Regexp">
      <property name="id"             value="todo-requires-issue"/>
      <property name="format"         value="//\s*TODO(?!\s*#\d+)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message"        value="Los TODOs deben referenciar un issue. Formato: // TODO #123 descripción del trabajo pendiente."/>
    </module>

    <!-- OWASP: No usar Random para operaciones de seguridad -->
    <module name="Regexp">
      <property name="id"             value="owasp-no-insecure-random"/>
      <property name="format"         value="new\s+java\.util\.Random\(\)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message"        value="OWASP A02: No usar java.util.Random para tokens de seguridad. Usar SecureRandom."/>
    </module>

    <!-- OWASP: No usar MD5 ni SHA-1 para contraseñas -->
    <module name="Regexp">
      <property name="id"             value="owasp-no-weak-hash"/>
      <property name="format"         value="getInstance\s*\(\s*&quot;(MD5|SHA-1|SHA1)&quot;\s*\)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message"        value="OWASP A02: MD5 y SHA-1 son inseguros para contraseñas. Usar BCrypt (Spring Security) o SHA-256 mínimo para tokens."/>
    </module>

    <!-- OWASP: No loggear passwords ni tokens -->
    <module name="Regexp">
      <property name="id"             value="owasp-no-log-sensitive"/>
      <property name="format"         value="log\.(info|debug|trace|warn|error)\s*\([^)]*[Pp]assword[^)]*\)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message"        value="OWASP A09: No loggear contraseñas ni tokens. Enmascarar datos sensibles antes de loggear."/>
    </module>

  </module>
</module>
